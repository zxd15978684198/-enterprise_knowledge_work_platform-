# PyKnora Phase 0 实验环境变量模板（LOCAL ONLY，不含任何真实秘密）。
#
# 纪律（AGENTS.md：秘密不入 Git）：
#   * 本文件是提交进仓库的模板，绝不写入真实密码/令牌/cookie/生产 DSN。
#   * compose.yaml 对这些键都带非秘密本地默认值，因此干净 checkout 可直接：
#         docker compose -f experiments/phase0/compose.yaml --profile core up -d
#   * 需要本地覆盖时复制为 experiments/phase0/.env（按意图忽略，不得提交）。
#   * 所有绑定仅 127.0.0.1，实验栈不对外网暴露。

# ---- Compose 身份 / 当前 profile ------------------------------------------
PHASE0_COMPOSE_PROJECT=pyknora-phase0
# 已实现 profile：core（postgres + redis）；未就绪：queue / parser / browser。
PHASE0_PROFILE=core

# ---- PostgreSQL 17（core profile，服务 postgres；宿主端口 5433）-----------
PHASE0_PG_HOST=127.0.0.1
PHASE0_PG_HOST_PORT=5433
PHASE0_PG_USER=pyknora
PHASE0_PG_PASSWORD=phase0-local-only
PHASE0_PG_DB=pyknora
PHASE0_PG_SSLMODE=disable
PHASE0_PG_DSN=postgresql://pyknora:phase0-local-only@127.0.0.1:5433/pyknora

# ---- Redis 7.4（core profile，服务 redis；宿主端口 6380）------------------
PHASE0_REDIS_HOST=127.0.0.1
PHASE0_REDIS_HOST_PORT=6380
PHASE0_REDIS_DB=0
PHASE0_REDIS_URL=redis://127.0.0.1:6380/0

# ---- 资源槽（docs/plans/2026-10-27-phase0-execution-plan.md §4.5.3）-------
# T02 独占 PG schema 前缀 p0_t02、Redis DB 0、宿主端口 5433/6380。
PHASE0_SCHEMA_PREFIX=p0_t02
