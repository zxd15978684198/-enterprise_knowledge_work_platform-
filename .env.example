# PyKnora 本地开发配置示例；复制为 .env 后按需修改。
# 生产部署必须覆盖 PYKNORA_JWT_SECRET 与 PYKNORA_DATABASE_URL。

PYKNORA_ENV=dev
PYKNORA_LOG_LEVEL=INFO

# 数据库：本地 postgres 暴露 5433（实验栈同名容器，密码仅为本地占位）；
# 容器内应改为 db:5432。
# 首次使用需建库：CREATE DATABASE pyknora_dev;
PYKNORA_DATABASE_URL=postgresql+asyncpg://pyknora:phase0-local-only@127.0.0.1:5433/pyknora_dev

# JWT：生成方式 python -c "import secrets;print(secrets.token_urlsafe(48))"
PYKNORA_JWT_SECRET=dev-insecure-change-me
PYKNORA_JWT_TTL_MINUTES=720

# Redis：本地暴露 6380（W19 起用于 Celery 与事件流）
PYKNORA_REDIS_URL=redis://127.0.0.1:6380/0

# CORS：JSON 数组
PYKNORA_CORS_ORIGINS=["http://localhost:5173"]
