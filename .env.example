# PyKnora 环境变量示例
#
# 用法：复制为 `.env`（`Copy-Item .env.example .env`），按需修改。
# 说明：
#   - 所有变量前缀 `PYKNORA_`，对应 `src/pyknora/config.py::Settings` 的同名字段（大写）。
#   - 本文件只放本地开发占位值，**不得写入真实凭据**；真实 key 走环境变量注入，不入库。
#   - 生产部署必须覆盖：`PYKNORA_JWT_SECRET`、`PYKNORA_DATABASE_URL`、`PYKNORA_S3_ACCESS_KEY`、
#     `PYKNORA_S3_SECRET_KEY`，并按需设 `PYKNORA_METRICS_TOKEN`。
#   - 未列出的字段会走 `Settings` 默认值；标「必填」的项在 prod 下不应留默认值。

# ── 应用 ─────────────────────────────────────────────────────────────
PYKNORA_ENV=dev                      # dev / test / prod
PYKNORA_LOG_LEVEL=INFO
# PYKNORA_APP_NAME=PyKnora           # 一般无需改
# PYKNORA_VERSION=0.1.0              # 一般无需改

# ── 数据库（PostgreSQL 17 + pgvector）─────────────────────────────────
# 本地：实验栈把 5433 映射到宿主机；容器内改为 db:5432。
# 首次使用需建库：CREATE DATABASE pyknora_dev;
PYKNORA_DATABASE_URL=postgresql+asyncpg://pyknora:phase0-local-only@127.0.0.1:5433/pyknora_dev
PYKNORA_DB_POOL_SIZE=5
PYKNORA_DB_MAX_OVERFLOW=5

# ── 认证（JWT）─────────────────────────────────────────────────────
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
PYKNORA_JWT_SECRET=dev-insecure-change-me
PYKNORA_JWT_ALGORITHM=HS256
PYKNORA_JWT_TTL_MINUTES=720

# ── Redis（Celery broker/backend + 事件流）───────────────────────────
PYKNORA_REDIS_URL=redis://127.0.0.1:6380/0

# ── CORS（JSON 数组，允许前端来源）─────────────────────────────────
PYKNORA_CORS_ORIGINS=["http://localhost:5173"]

# ── 静态前端（W22）─────────────────────────────────────────────────
# 留空 = 用包内 src/pyknora/web（容器里用绝对路径覆盖）。
# PYKNORA_WEB_DIR=

# ── 文档入库（W19）─────────────────────────────────────────────────
PYKNORA_UPLOAD_DIR=data/uploads      # 本地存储根目录（storage_backend=local 时生效）
PYKNORA_MAX_UPLOAD_BYTES=26214400    # 单文件上限，默认 25 MiB
PYKNORA_CHUNK_SIZE=800               # 分块目标字符数（100–4000）
PYKNORA_CHUNK_OVERLAP=120            # 分块重叠字符数（0–1000）
PYKNORA_MAX_CHUNKS_PER_DOCUMENT=2000  # 单文档分块上限

# ── 检索与 RAG（W20）───────────────────────────────────────────────
# embedding_dim 必须与 db/migrations/0003 的 vector(1024) 一致；改维度需新增迁移。
PYKNORA_EMBEDDING_PROVIDER=local     # local = 字符 n-gram 哈希替身（D-01 未接入真实模型）
PYKNORA_EMBEDDING_DIM=1024
PYKNORA_CHAT_PROVIDER=local          # local = 抽取式替身（D-01 未接入真实生成模型）
PYKNORA_RETRIEVAL_CANDIDATE_K=40     # 每路召回候选数
PYKNORA_RETRIEVAL_TOP_K=8            # 融合后返回条数
PYKNORA_RRF_K=60                     # RRF 平滑常数
# 向量路相似度下限：0.10 是对本地替身实测的经验值，换真实 embedding 后必须重新标定（D-02）。
PYKNORA_RETRIEVAL_MIN_SIMILARITY=0.10
PYKNORA_RAG_MAX_CONTEXT_CHUNKS=6     # 送进模型的片段上限
PYKNORA_RAG_HISTORY_TURNS=6          # 拼进提示的历史消息条数
# 证据充分性阈值：0 = 关闭。W20 未校准，真实 embedding 接入后按 ADR-0014 裁决取值（D-02）。
PYKNORA_RAG_MIN_SIMILARITY=0.0

# ── 单 URL 受控导入（W21）──────────────────────────────────────────
PYKNORA_URL_FETCH_TIMEOUT_SECONDS=15.0
PYKNORA_URL_MAX_BYTES=5242880        # 5 MiB
PYKNORA_URL_MAX_REDIRECTS=3
# 默认 False（生产语义）。置 True = 允许访问回环/私网/链路本地地址，
# 仅测试与本地联调可开；生产打开等于关闭 SSRF 防护。
PYKNORA_URL_ALLOW_PRIVATE_NETWORK=false

# ── 对象存储（W22，local | s3）─────────────────────────────────────
PYKNORA_STORAGE_BACKEND=local        # local = 本地目录；s3 = MinIO 等兼容端点
PYKNORA_S3_ENDPOINT_URL=http://127.0.0.1:9000
PYKNORA_S3_ACCESS_KEY=pyknora        # 生产必须覆盖
PYKNORA_S3_SECRET_KEY=pyknora-dev-secret   # 生产必须覆盖，禁止提交真实值
PYKNORA_S3_BUCKET=pyknora            # 启动时自动创建
PYKNORA_S3_REGION=us-east-1          # MinIO 不校验，但需给值
PYKNORA_S3_PRESIGN_SECONDS=900       # 预签名 URL 有效期（30–86400）

# ── 异步队列（W22，inline | queue）─────────────────────────────────
PYKNORA_INGEST_MODE=inline           # inline = 请求内同步入库；queue = Celery worker
PYKNORA_CELERY_TASK_TIME_LIMIT=900        # 单任务硬超时（秒）
PYKNORA_CELERY_TASK_SOFT_TIME_LIMIT=840   # 单任务软超时（秒）

# ── 可观测性（W23）─────────────────────────────────────────────────
# 非空时 /api/v1/metrics 需请求头 x-metrics-token；留空 = 不校验（仅建议本地）。
# PYKNORA_METRICS_TOKEN=

# ── D-01 / D-02 接入时追加（当前代码不读取，填了也不生效）───────────
# 拿到真实模型 endpoint + key 后，先加适配器与配置字段，再启用下面几行：
# PYKNORA_EMBEDDING_PROVIDER=openai
# PYKNORA_EMBEDDING_BASE_URL=https://api.openai.com/v1
# PYKNORA_EMBEDDING_MODEL=text-embedding-3-small
# PYKNORA_EMBEDDING_API_KEY=<从环境注入，禁止写进文件或提交>
# PYKNORA_CHAT_PROVIDER=openai
# PYKNORA_CHAT_BASE_URL=https://api.openai.com/v1
# PYKNORA_CHAT_MODEL=gpt-4o-mini
# PYKNORA_CHAT_API_KEY=<从环境注入，禁止写进文件或提交>
